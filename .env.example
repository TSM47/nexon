# Copy to .env and adjust values before running

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=nexon
POSTGRES_USER=nexon
POSTGRES_PASSWORD=nexon_secret

# ── Application ───────────────────────────────────────────────────────────
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# ── CORS — space-separated list of allowed origins ────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── Next.js public env (baked at build time) ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/api/ws
